# ---- MF Bank web · development ----
VITE_ENV=development
# true = in-memory mock backend (no network). false = real API.
VITE_USE_MOCK=true
VITE_API_URL=https://ibuat.scu.sc:8081/mfmbs/mbintf/ina/processibsrequest.jsp
# Tip for local dev against UAT without CORS: VITE_API_URL=/api/mfmbs/mbintf/ina/processibsrequest.jsp
VITE_PROXY_TARGET=https://ibuat.scu.sc:8081/
VITE_RSA_PUBLIC_
VITE_REQ_SOURCE=INETBSTATIC
VITE_REQ_SOURCE_ID=572a3ae404af4ea8
VITE_REQ_LK=yN21qw+rjznMF4TawKXNClQ==
# minutes of inactivity before automatic logout
VITE_IDLE_TIMEOUT_MIN=5
VITE_BASE_PATH=/
# absolute session limit in minutes (0 = off)
VITE_SESSION_MAX_MIN=30
# backend service code that receives security events (leave empty until the backend provides one)
VITE_THREAT_REPORT_SERVICE=

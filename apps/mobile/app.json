{
  "expo": {
    "name": "MF Bank",
    "slug": "mf-bank",
    "scheme": "mfbank",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#002B63",
    "splash": {
      "backgroundColor": "#002B63",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.mfbank.mobile",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mfbank.mobile",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.READ_PHONE_STATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "./plugins/withSslPinning",
        {
          "iosPinType": "ca",
          "domains": [
            {
              "host": "ibuat.scu.sc",
              "includeSubdomains": true,
              "expiration": "2027-12-31",
              "pins": [
                "REPLACE_WITH_CURRENT_CA_SPKI_SHA256_BASE64",
                "REPLACE_WITH_BACKUP_CA_SPKI_SHA256_BASE64"
              ]
            }
          ]
        }
      ],
      "./plugins/withAndroidHardening"
    ]
  }
}

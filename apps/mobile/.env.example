# ---- MF Bank mobile ----
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time (like VITE_*).
# true = in-memory mock backend (no network). false = real API.
EXPO_PUBLIC_USE_MOCK=true
EXPO_PUBLIC_API_URL=https://ibuat.scu.sc:8081/mfmbs/mbintf/ina/processibsrequest.jsp
EXPO_PUBLIC_RSA_PUBLIC_
# Ask the backend team which ReqSource identifies the mobile channel.
EXPO_PUBLIC_REQ_SOURCE=INETBSTATIC
EXPO_PUBLIC_REQ_SOURCE_ID=572a3ae404af4ea8
EXPO_PUBLIC_REQ_LK=yN21qw+rjznMF4TawKXNClQ==
# minutes of inactivity (or time in background) before automatic logout
EXPO_PUBLIC_IDLE_TIMEOUT_MIN=5

# ---- Device security (modules/device-security, policy in src/core/security/securityPolicy.ts) ----
# enforce = block/warn per policy · report = checks run, no blocking (default in development) · off
# Leave empty to use the default: report in development builds, enforce in release builds.
EXPO_PUBLIC_DEVICE_SECURITY=
# true = block apps not installed from Google Play / App Store (keep false for UAT APKs / TestFlight)
EXPO_PUBLIC_REQUIRE_STORE_INSTALL=false
# true = send the extra results (IsVPN, IsProxy, IsFridaDetected…) with every request — agree field names with the backend first
EXPO_PUBLIC_SEND_SECURITY_FIELDS=false
# true = ask for the phone permission at start-up to read SIM details (getSimData)
EXPO_PUBLIC_COLLECT_SIM_DATA=false
# absolute session limit in minutes (0 = off)
EXPO_PUBLIC_SESSION_MAX_MIN=30
# backend service code that receives security events (#31); empty until the backend provides one
EXPO_PUBLIC_THREAT_REPORT_SERVICE=
# #30 bank-hosted JSON with minAppVersion / policy overrides / extra blacklist (https only)
EXPO_PUBLIC_SECURITY_CONFIG_URL=
# #13 APK locking: SHA-256 fingerprints of the bank's signing certificates, comma separated
# (Play Console → App integrity → App signing key + upload key). Empty = check not applied.
EXPO_PUBLIC_ANDROID_SIGNING_SHA256=
# #14 the client asked for debugger detection to be optional: false = warn, true = block
EXPO_PUBLIC_BLOCK_DEBUGGER=false
